__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
# Everything the tool writes into output/ is generated — drafts, summaries,
# their HTML, the search log. Listing extensions one at a time meant each new
# output type silently became committable: the search log was added and 396
# rows of it landed in two commits before anyone noticed. Ignore the folder's
# contents and keep the folder.
output/*
!output/.gitkeep
/library/
/processed/
/thesis_tools_project.json
.env
